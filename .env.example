# Локальные переменные окружения для запуска без Docker Compose.
DB_HOST=localhost
DB_PORT=5432

EUREKA_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888

KEYCLOAK_ISSUER=http://localhost:8180/realms/bank
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/bank/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URI=http://localhost:8180/realms/bank/protocol/openid-connect/token
KEYCLOAK_AUTHORIZATION_URI=http://localhost:8180/realms/bank/protocol/openid-connect/auth
KEYCLOAK_USERINFO_URI=http://localhost:8180/realms/bank/protocol/openid-connect/userinfo
KEYCLOAK_END_SESSION_URI=http://localhost:8180/realms/bank/protocol/openid-connect/logout

FRONT_CLIENT_SECRET=front-secret
ACCOUNTS_CLIENT_SECRET=accounts-secret
CASH_CLIENT_SECRET=cash-secret
TRANSFER_CLIENT_SECRET=transfer-secret

GATEWAY_BASE_URL=http://gateway
